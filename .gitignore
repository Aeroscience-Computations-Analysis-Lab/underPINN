# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# ── Virtual envs ─────────────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Tooling / caches ─────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
coverage.xml
.coverage

# ── Editors / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store

# ── Heavy, regenerable run artifacts ─────────────────────────────────────────
# NOTE: outputs/ directories are intentionally NOT ignored wholesale, so the
# committed figure images (*.png etc.) stay tracked.  Only the large binary /
# checkpoint artifacts inside them are ignored.
**/*.msgpack
**/restart/
**/windows/
**/vtu_*/
**/*.pvd
**/*.vtu
**/*_cache/
**/stl_cache/
